{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "setpoint": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/setpoint",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": ["**/logo-source.jpeg"]
              }
            ],
            "styles": [
              "node_modules/driver.js/dist/driver.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "src/fonts.css",
              "src/styles/tokens.css",
              "src/styles/components/button.css",
              "src/styles/components/card.css",
              "src/styles/components/dialog.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": true,
                "vendor": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "setpoint:build:production"
            },
            "development": {
              "buildTarget": "setpoint:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "::development",
            "coverageInclude": ["src/app/core/**/*.ts"],
            "coverageExclude": ["src/**/*.spec.ts"],
            "coverageThresholds": {
              "statements": 73,
              "branches": 71,
              "functions": 82,
              "lines": 72
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
