{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "setpoint": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/setpoint",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [{"glob":"**/*","input":"public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"budgets":[{"type":"initial","maximumWarning":"600kB","maximumError":"1MB"},{"type":"anyComponentStyle","maximumWarning":"8kB","maximumError":"12kB"}],"outputHashing":"all"},
            "development": {"optimization":false,"extractLicenses":false,"sourceMap":true}
          },
          "defaultConfiguration":"production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget":"setpoint:build:production"},
            "development": {"buildTarget":"setpoint:build:development"}
          },
          "defaultConfiguration":"development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
