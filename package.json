{
  "name": "setpoint-angular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "postbuild": "node scripts/upload-posthog-sourcemaps.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:db": "node --test tests/dashboard-activity.test.cjs tests/dashboard-insights.test.cjs tests/inactive-tournament-cleanup.test.cjs tests/local-archive.test.cjs tests/offline-sync.test.cjs tests/tournament-report.test.cjs",
    "test:coverage": "ng test --no-watch --coverage",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "knip": "knip",
    "check": "npm run lint && npm run lint:styles && npm run format:check && npm run typecheck && npm run knip && npm test && npm run test:db && npm run build",
    "prepare": "husky",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@supabase/supabase-js": "^2.118.0",
    "@zhuravlev-biz/padel-score-engine": "^1.2.0",
    "driver.js": "^1.10.2",
    "posthog-js": "^1.444.0",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@posthog/cli": "^0.19.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^18.0.9",
    "eslint": "9.39.5",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "prettier": "3.10.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint --fix"
    ],
    "*.{json,md,cjs,mjs,yml}": [
      "prettier --write"
    ],
    "{src,e2e}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
