{
  "name": "setpoint-angular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "postbuild": "node scripts/upload-posthog-sourcemaps.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:db": "node --test tests/dashboard-activity.test.cjs tests/dashboard-insights.test.cjs tests/inactive-tournament-cleanup.test.cjs tests/local-archive.test.cjs tests/offline-sync.test.cjs tests/tournament-report.test.cjs",
    "test:db:supabase": "supabase test db",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "node scripts/db-lint.cjs",
    "db:migrations": "node scripts/check-migrations.cjs",
    "db:types": "supabase gen types typescript --local --schema public > src/app/core/adapters/supabase/database.types.ts",
    "test:coverage": "ng test --no-watch --coverage",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "knip": "knip",
    "check": "npm run lint && npm run lint:styles && npm run format:check && npm run typecheck && npm run knip && npm test && npm run test:db && npm run build",
    "prepare": "husky",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@supabase/supabase-js": "^2.119.0",
    "@zhuravlev-biz/padel-score-engine": "^1.2.0",
    "driver.js": "^1.12.1",
    "posthog-js": "^1.447.15",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "valibot": "^1.5.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@posthog/cli": "^0.19.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^18.0.10",
    "eslint": "9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "prettier": "3.10.0",
    "squawk-cli": "^2.72.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint --fix"
    ],
    "*.{json,md,cjs,mjs,yml}": [
      "prettier --write"
    ],
    "{src,e2e}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
